# Optional server-side AI; choose a model available to your account.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Persistent directory; defaults to ./data
# DATA_DIR=/absolute/path/to/persistent/data
# Write/privileged endpoints (/api/import, /api/assumptions, /api/forecast, /api/advisor)
# require Authorization: Bearer <AGRO_API_TOKEN> by default.
# AGRO_API_TOKEN=
# Optional: require auth on read (GET) endpoints too:
# AGRO_REQUIRE_AUTH=true
# Local development only (emits a startup security warning):
# AGRO_ALLOW_ANON_WRITES=true
# Only after provisioning an actual persistent volume, not /tmp:
# AGRO_PERSISTENT_VOLUME=true

# Vercel Cron & Automated Refresh Protection (keep server-side only)
# Configure CRON_SECRET in Vercel project environment variables.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically.
# CRON_SECRET=
# AGRO_REFRESH_TOKEN=

# Durable Storage on Vercel Serverless (Vercel KV / Upstash Redis)
# Automatically populated when you connect Vercel KV in the Vercel dashboard.
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
