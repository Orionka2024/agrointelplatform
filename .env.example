# ==============================================================================
# AI Advisor Configuration
# You can use ANY of the providers below. The app will automatically detect it.
# ==============================================================================

# OPTION 1: Google Gemini (100% FREE Tier, no credit card required)
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OPTION 2: OpenAI API (Requires API credits from platform.openai.com)
# NOTE: ChatGPT Plus ($20/mo) is for chatgpt.com only, OpenAI API is pay-as-you-go (~$0.001/req)
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# OPTION 3: Anthropic Claude (Requires pre-paid credits from console.anthropic.com)
# Get key from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OPTIONAL: Explicitly choose provider if multiple keys are set (gemini, openai, anthropic)
# AI_PROVIDER=gemini
