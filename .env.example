# Optional server-side AI; choose a model available to your account.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Persistent directory; defaults to ./data
# DATA_DIR=/absolute/path/to/persistent/data
# Shared use requires a trusted authenticating reverse proxy.
# AGRO_REQUIRE_AUTH=true
# AGRO_API_TOKEN=
# Only after provisioning an actual persistent volume, not /tmp:
# AGRO_PERSISTENT_VOLUME=true
